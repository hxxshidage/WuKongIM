mode: "debug" 
addr: "tcp://0.0.0.0:5100" # tcp监听地址
httpAddr: "0.0.0.0:5001" # http api监听地址
#httpAddr: "127.0.0.1:5001" # http api监听地址
httpInternalKey: "5iDlKLrp21jCRid3" # 5iDlKLrp21jCRid3
wsAddr: "ws://0.0.0.0:5200"  # websocket ws 监听地址
rootDir: "./wukongimdata/1" # 数据存储目录
pprofOn: true
stress: true # 是否开启压力测试模式
# whitelistOffOfPerson: false
intranet:
  tcpAddr: "127.0.0.1:5100" # 内网tcp地址
external: # 公网配置
  ip: "" # 节点外网IP，客户端能够访问到的IP地址，如果客户端是内网使用，这里也可以填写内网IP
  tcpAddr: "192.168.1.155:5100" #  默认自动获取， 节点的TCP地址 对外公开，APP端长连接通讯  格式： ip:port
  wsAddr: "ws://192.168.1.155:5200" # 默认自动获取， 节点的wsAdd地址 对外公开 WEB端长连接通讯 格式： ws://ip:port  （支持域名配置）
#  wssAddr: "" # 对外的wssAddr地址，也就是客户端真正连接的地址 格式：wss://ip:port （支持域名配置）
logger:
  traceOn: false
  lineNum: true
manager:  # 管理端配置
  on: true
  addr: "0.0.0.0:5300"
demo:
  on: true  
conversation:
  on: true   
webhook: # webhook配置 用于接收消息通知事件，详情请查看文档
  grpcAddr: "192.168.1.155:5008"
  # httpAddr: "http://127.0.0.1:8000/v1/integrations/wukongim/webhook"
cluster:
  nodeId: 1 # 节点ID
  addr: "tcp://127.0.0.1:10001"
  serverAddr: "127.0.0.1:10001" # 节点通讯地址
  apiUrl: "http://127.0.0.1:5001"
  
# 认证配置 用户名:密码:资源:权限 *表示通配符   资源格式也可以是[资源ID:权限]  
 # 例如:  - "admin:pwd:[clusterchannel:rw]" 表示admin用户密码为pwd对clusterchannel资源有读写权限, 
 # - "admin:pwd:*" 表示admin用户密码为pwd对所有资源有读写权限    
auth: 
  superToken: "xxxxxx" # 超级管理员token, 如果配置了超级管理员token, 携带超级管理员的token则可以跳过认证（适合第三方业务服务端使用此方式）
  kind: 'jwt' # 认证方式 jwt: jwt认证 none: 无需认证
  users:
    - "admin:pwd:*" 
    - "guest:guest:[*:r]" # guest用户密码为guest对所有资源有读权限
jwt: ## jwt认证方式
  secret: "xxxxx" # jwt密钥
  expire: 30d # jwt过期时间

customerService: # 客服配置
  visitorsOn: true # 是否开启访客用户访问
  visitorsSuffix: "____vstr" # 访客用户后缀 (带有此后缀的用户将被认为是访客用户，访客用户登录免去token验证，但是只能给访客频道发送消息)